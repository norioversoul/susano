# Copy to .env.local and fill in. Never commit .env.local.

# Comfy Cloud API key (platform.comfy.org). Used for Comfy Cloud jobs and for the Tsukuyomi deployment.
COMFY_CLOUD_API_KEY=

# Endpoint of your Comfy deployment built from deploy/tsukuyomi/comfy-build.yaml,
# e.g. https://dep-xxxxxxxx.run.comfy.app (from `comfy deploy ls`). Tsukuyomi and Influencer videos need it.
SUSANO_TSUKUYOMI_URL=

# Optional overrides
# COMFY_CLOUD_URL=https://cloud.comfy.org
# SUSANO_SWAP_LORA=
# SUSANO_TURBO_LORA=

# A shared instance (see README, Run it online)
# SUSANO_INVITE_CODES=code-one,code-two
# SUSANO_SAFE_MODE=locked
# SUSANO_DAILY_LIMIT=40
# SUSANO_MAX_DREAM_PARTS=3
